{
  "id": "nowen.hello",
  "name": "Hello Nowen",
  "description": "Nowen Extension Platform 最小示例：问候 Action、外网白名单声明与编辑器命令",
  "version": "1.1.0",
  "apiVersion": 2,
  "publisher": "nowen",
  "categories": ["productivity"],
  "repository": "https://github.com/cropflre/nowen-note",
  "license": "MIT",
  "engines": { "nowen": ">=1.5.1 <2.0.0" },
  "runtime": "sandbox-js",
  "main": "index.js",
  "permissions": ["external:fetch"],
  "permissionConfig": { "externalFetchHosts": ["api.example.com"] },
  "actions": [
    {
      "id": "hello",
      "name": "Hello Nowen",
      "description": "返回一条问候语",
      "execution": "interactive",
      "input": { "name": { "type": "string", "required": false } }
    }
  ],
  "contributes": {
    "editorCommands": [
      {
        "id": "nowen.hello.insert-greeting",
        "title": "插入 Hello 问候",
        "keywords": ["hello", "greeting", "问候"],
        "keybinding": "Mod-Alt-H",
        "when": "editorFocused",
        "category": "示例",
        "action": "hello"
      }
    ]
  }
}
